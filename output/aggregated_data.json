  {
    "name": "active_entities_summary",
    "description": "Counts the total number of unique mandates and organisations that have received at least one payment.",
    "sql": "SELECT COUNT(DISTINCT p.mandate_id) AS total_mandates_with_payments, COUNT(DISTINCT m.organisation_id) AS total_organisations_with_payments FROM payments p JOIN mandates m ON p.mandate_id = m.id",
    "rows": [
      {
        "total_mandates_with_payments": 8440,
        "total_organisations_with_payments": 208
      }
    ]
  },
  {
    "name": "mandate_payment_efficiency",
    "description": "Computes the average amount for individual payments and the overall average number of payments associated with each mandate.",
    "sql": "SELECT AVG(p.amount) AS average_payment_amount_per_transaction, COUNT(p.id) / COUNT(DISTINCT m.id) AS average_payments_per_mandate_globally FROM mandates m LEFT JOIN payments p ON m.id = p.mandate_id",
    "rows": [
      {
        "average_payment_amount_per_transaction": 127.8968506619633,
        "average_payments_per_mandate_globally": "3.5669"
      }
    ]
  },
