    "description": "Identifies the top 10 organisations by total payment amount, showing their parent vertical and the sum of payments.",
    "sql": "SELECT o.id AS organisation_id, o.parent_vertical, SUM(p.amount) AS total_payment_amount FROM organisations o JOIN mandates m ON o.id = m.organisation_id JOIN payments p ON m.id = p.mandate_id GROUP BY o.id, o.parent_vertical ORDER BY total_payment_amount DESC LIMIT 10",
